@model LoginProfileViewModel
@{
    ViewData["Title"] = "ورود";
}
@section css {
<link rel="stylesheet" href="~/css/desktop/base.css"><link rel="stylesheet" href="~/css/desktop/login-profile.css">
}
<div dir="rtl" style="font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; min-height: 100vh; display: flex; flex-wrap: wrap">

<section style="flex: 1 1 520px; min-width: 0; display: flex; align-items: center; justify-content: center; padding: 48px 24px">
<div style="width: 100%; max-width: 420px; display: flex; flex-direction: column; gap: 28px">
<a href="/" style="display: flex; align-items: center; gap: 10px; color: #111827">
<svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#FFFFFF" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg>
<span style="font-weight: 800; font-size: 22px">شکار</span>
</a>
<div style="display: flex; flex-direction: column; gap: 8px">
<span style="font-size: 13px; color: #6B7280">مرحله ۳ از ۳</span>
<div style="display: flex; gap: 6px"><span style="flex: 1; height: 4px; border-radius: 4px; background: #0F766E"></span><span style="flex: 1; height: 4px; border-radius: 4px; background: #0F766E"></span><span style="flex: 1; height: 4px; border-radius: 4px; background: #0F766E"></span></div>
</div>

<div style="display: flex; flex-direction: column; gap: 16px">
<div><h1 style="margin: 0 0 6px; font-size: 28px; font-weight: 800">یه آشنایی کوچیک!</h1><p style="margin: 0; color: #6B7280">فقط همین یه بار می‌پرسیم.</p><span style="display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; background: #FBF6E6; color: #8A6A0B; border: 1px solid #F1DFA6; padding: 6px 12px; border-radius: 999px; font-size: 13px; font-weight: 700"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="2"></rect><path d="M3 12h18M12 8v13"></path></svg>هدیه‌ی ثبت‌نام: ۲۴ ساعت اشتراک رایگان</span></div>
<form method="post" action="/login/profile" style="display: flex; flex-direction: column; gap: 16px">
<input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
<div style="display: flex; gap: 12px">
<div style="flex: 1; display: flex; flex-direction: column; gap: 8px"><label for="fn" style="font-weight: 600; font-size: 14px">نام</label><input id="fn" name="FirstName" class="zin" value="" required></div>
<div style="flex: 1; display: flex; flex-direction: column; gap: 8px"><label for="ln" style="font-weight: 600; font-size: 14px">نام خانوادگی</label><input id="ln" name="LastName" class="zin" value="" required></div>
</div>
<div style="display: flex; flex-direction: column; gap: 8px">
<label for="ct" style="font-weight: 600; font-size: 14px">شهر</label>
<select id="ct" name="CityId" class="zin">
@foreach (var c in Model.Cities)
{
    <option value="@c.Id" disabled="@(!c.IsActive)" selected="@(c.IsActive)">@c.Name@(c.IsActive ? "" : " (به‌زودی)")</option>
}
</select>
</div>
<span asp-validation-summary="All" style="color: #DC2626; font-size: 12px"></span>
<button type="submit" class="zbtn zbtn-p" style="border: 0; cursor: pointer; font-family: inherit">بزن بریم!</button>
</form>

</div>

</div>
</section>

<aside aria-hidden="true" style="flex: 1 1 520px; min-width: 0; min-height: 420px; background: #EEF5F3; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; padding: 56px 48px 48px; color: #111827">
<div style="position: relative; display: flex; flex-direction: column; gap: 10px">
<span style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: #0F766E; font-weight: 600"><span class="zlive" style="background: #0F766E"></span>همین الان در حال اسکن</span>
<b style="font-size: 32px; line-height: 1.4">ماشین زیر قیمت رو قبل از همه شکار کن</b>
</div>
<div style="position: relative; flex: 1; display: flex; align-items: center">
<img src="~/assets/brand/signup-sedan.webp" alt="" style="display: block; width: 100%; height: auto; mix-blend-mode: multiply">

</div>
<div style="position: relative; display: flex; gap: 10px; flex-wrap: wrap">
<span style="background: #FFFFFF; border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 700">امتیاز ۰ تا ۱۰۰</span>
<span style="background: #FFFFFF; border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 700">قیمت منصفانه</span>
<span style="background: #D4A017; border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 700">فرصت طلایی</span>
</div>
</aside>
</div>
