@model LoginProfileViewModel
@{
    ViewData["Title"] = "ورود";
}
@section css {
<link rel="stylesheet" href="~/css/mobile/base.css"><link rel="stylesheet" href="~/css/mobile/login-profile.css">
}
<div dir="rtl" style="width: 100%; max-width: 480px; margin: 0 auto; min-height: 100vh; font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; display: flex; flex-direction: column; padding: 16px 16px 24px; gap: 20px">
<div style="display: flex; align-items: center; justify-content: space-between">
<a href="/" aria-label="بازگشت" style="width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: #F6F8F8"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
<span style="font-size: 13px; color: #6B7280">مرحله ۳ از ۳</span>
</div>
<div style="display: flex; gap: 6px"><span style="flex: 1; height: 4px; border-radius: 4px; background: #0F766E"></span><span style="flex: 1; height: 4px; border-radius: 4px; background: #0F766E"></span><span style="flex: 1; height: 4px; border-radius: 4px; background: #0F766E"></span></div>
<div aria-hidden="true" style="height: 140px; border-radius: 20px; background: #EEF5F3; position: relative; overflow: hidden; display: grid; place-items: center; padding: 0 12px">
<img src="~/assets/brand/signup-sedan.webp" alt="" style="display: block; width: 100%; height: auto; mix-blend-mode: multiply">

</div>

<div style="display: flex; flex-direction: column; gap: 14px; flex: 1">
<div><h1 style="margin: 0 0 4px; font-size: 24px; font-weight: 800">یه آشنایی کوچیک!</h1><p style="margin: 0; color: #6B7280">فقط همین یه بار می‌پرسیم.</p><span style="display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; background: #FBF6E6; color: #8A6A0B; border: 1px solid #F1DFA6; padding: 5px 10px; border-radius: 999px; font-size: 12px; font-weight: 700">هدیه‌ی ثبت‌نام: ۲۴ ساعت اشتراک رایگان</span></div>
<form method="post" action="/login/profile" style="display: flex; flex-direction: column; gap: 14px; flex: 1">
<input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
<div style="display: flex; flex-direction: column; gap: 6px"><label for="fn" style="font-weight: 600; font-size: 14px">نام</label><input id="fn" name="FirstName" class="zin" value="" required></div>
<div style="display: flex; flex-direction: column; gap: 6px"><label for="ln" style="font-weight: 600; font-size: 14px">نام خانوادگی</label><input id="ln" name="LastName" class="zin" value="" required></div>
<div style="display: flex; flex-direction: column; gap: 6px">
<label for="ct" style="font-weight: 600; font-size: 14px">شهر</label>
<select id="ct" name="CityId" class="zin">
@foreach (var c in Model.Cities)
{
    <option value="@c.Id" disabled="@(!c.IsActive)" selected="@(c.IsActive)">@c.Name@(c.IsActive ? "" : " (به‌زودی)")</option>
}
</select>
</div>
<span asp-validation-summary="All" style="color: #DC2626; font-size: 12px"></span>
<div style="margin-top: auto">
<button type="submit" class="zbtn zbtn-p" style="width: 100%; border: 0; cursor: pointer; font-family: inherit">بزن بریم!</button>
</div>
</form>
</div>

</div>
