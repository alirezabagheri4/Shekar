@{
    ViewData["Title"] = "در حال تحلیل";
}
@section css {
<link rel="stylesheet" href="~/css/mobile/base.css"><link rel="stylesheet" href="~/css/mobile/analyze.css">
}
<div dir="rtl" style="width: 100%; max-width: 480px; margin: 0 auto; min-height: 100vh; font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; display: flex; flex-direction: column">
<header style="padding: 12px 16px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #EEF0F2">
<a href="/appraise" aria-label="برگشت" style="width: 44px; height: 44px; border-radius: 12px; background: #F6F8F8; display: grid; place-items: center; flex: none"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
<div style="min-width: 0"><span style="font-size: 12px; color: #6B7280">آگهی</span><b style="display: block; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">پژو ۲۰۷ دنده‌ای پانوراما ۱۴۰۲</b></div>
</header>

<main style="padding: 16px; display: flex; flex-direction: column; gap: 14px; flex: 1">

<div aria-live="polite" style="display: flex; flex-direction: column; gap: 14px">
<div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 10px">
<div><span style="display: flex; align-items: center; gap: 6px; color: #0F766E; font-weight: 700; font-size: 12px"><span class="zlive"></span>هوش مصنوعی شکار داره کار می‌کنه</span><h1 style="margin: 4px 0 0; font-size: 20px; font-weight: 800; line-height: 1.5">قیمت رو با بازار مقایسه می‌کنیم…</h1></div>
<div style="text-align: left; flex: none"><b style="font-size: 32px; line-height: 1; color: #0F766E">۵۸٪</b><div style="font-size: 11px; color: #6B7280; margin-top: 4px">۹ ثانیه مونده</div></div>
</div>
<div role="progressbar" aria-valuenow="58" aria-valuemin="0" aria-valuemax="100" aria-label="پیشرفت تحلیل" style="height: 6px; background: #E6F4F1; border-radius: 8px; overflow: hidden"><div class="zprog" style="height: 100%; width: 58%; background: #0F766E;"></div></div>

<div style="position: relative; height: 210px; border-radius: 20px; background: #F6F8F8; overflow: hidden">
<div aria-hidden="true" style="position: absolute; left: -20%; right: -20%; bottom: -20px; height: 120px; background-image: linear-gradient(#DCE5E4 1px, transparent 1px), linear-gradient(90deg, #DCE5E4 1px, transparent 1px); background-size: 30px 30px; transform: perspective(340px) rotateX(62deg); transform-origin: bottom"></div>
<svg viewBox="0 0 420 200" role="img" aria-label="ماشین در حال اسکن" style="position: absolute; left: 8%; width: 84%; bottom: 30px">
<ellipse cx="212" cy="176" rx="196" ry="13" fill="#0F172A" opacity=".16"></ellipse>
<path d="M20 150 L27 122 Q34 104 68 99 L128 92 L174 58 Q187 49 208 49 L274 49 Q297 49 314 64 L348 94 L384 100 Q405 105 407 123 L409 146 Q409 156 398 156 L31 156 Q20 156 20 150 Z" fill="#F1F4F4" stroke="#8A999C" stroke-width="1.6"></path>
<path d="M146 92 L181 62 Q188 57 197 57 L240 57 L240 92 Z" fill="#334155"></path><path d="M250 92 L250 57 L276 57 Q292 57 302 66 L329 92 Z" fill="#334155"></path>
<circle cx="102" cy="156" r="29" fill="#111827"></circle><circle cx="102" cy="156" r="14" fill="#9CA3AF"></circle><circle cx="332" cy="156" r="29" fill="#111827"></circle><circle cx="332" cy="156" r="14" fill="#9CA3AF"></circle>
</svg>
<div class="zbeam" aria-hidden="true"></div>
<span class="zmark" style="position: absolute; top: 14px; right: 12px; background: #FFFFFF; border-radius: 999px; padding: 4px 10px; font-size: 11px; font-weight: 700; box-shadow: 0 4px 12px rgba(17,24,39,.08)">کارکرد: ۲۸ هزار</span>
<span class="zmark" style="position: absolute; top: 14px; left: 12px; background: #111827; color: #FFFFFF; border-radius: 999px; padding: 4px 10px; font-size: 11px; font-weight: 700">بازار: ۱٫۵۶ میلیارد</span>

</div>

<div class="zbox">
<ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px">

<li style="display: flex; gap: 10px; align-items: flex-start">
<span style="width: 24px; height: 24px; border-radius: 50%; background: #0F766E; display: grid; place-items: center; flex: none"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span>

<div style="display: flex; flex-direction: column"><b style="font-size: 14px; color: #111827">خوندن آگهی</b><span style="font-size: 12px; color: #6B7280">عنوان، قیمت، ۱۲ عکس و توضیحات</span></div>
</li>

<li style="display: flex; gap: 10px; align-items: flex-start">
<span style="width: 24px; height: 24px; border-radius: 50%; background: #0F766E; display: grid; place-items: center; flex: none"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span>

<div style="display: flex; flex-direction: column"><b style="font-size: 14px; color: #111827">پیدا کردن ماشین‌های مشابه</b><span style="font-size: 12px; color: #6B7280">۴۲ آگهی مشابه پیدا شد</span></div>
</li>

<li style="display: flex; gap: 10px; align-items: flex-start">

<svg class="zspin" width="24" height="24" viewBox="0 0 26 26" aria-hidden="true" style="flex: none"><circle cx="13" cy="13" r="10" fill="none" stroke="#E6F4F1" stroke-width="3"></circle><path d="M13 3a10 10 0 0110 10" fill="none" stroke="#0F766E" stroke-width="3" stroke-linecap="round"></path></svg>

<div style="display: flex; flex-direction: column"><b style="font-size: 14px; color: #111827">مقایسه با قیمت بازار</b><span style="font-size: 12px; color: #6B7280">۹۲۲ قیمت مقایسه شد</span></div>
</li>

<li style="display: flex; gap: 10px; align-items: flex-start">

<span style="width: 24px; height: 24px; border-radius: 50%; border: 2px solid #E5E7EB; flex: none"></span>
<div style="display: flex; flex-direction: column"><b style="font-size: 14px; color: #6B7280">بررسی ریسک‌ها</b><span style="font-size: 12px; color: #6B7280">در صف</span></div>
</li>

<li style="display: flex; gap: 10px; align-items: flex-start">

<span style="width: 24px; height: 24px; border-radius: 50%; border: 2px solid #E5E7EB; flex: none"></span>
<div style="display: flex; flex-direction: column"><b style="font-size: 14px; color: #6B7280">امتیازدهی نهایی</b><span style="font-size: 12px; color: #6B7280">در صف</span></div>
</li>

</ol>
</div>

<div style="background: #111827; border-radius: 20px; padding: 14px; color: #E5E7EB; display: flex; flex-direction: column; gap: 8px; min-height: 120px">
<span style="font-size: 12px; color: #6B7280; display: flex; gap: 6px; align-items: center"><span class="zlive" style="background: #5EEAD4"></span>یافته‌ها، همین الان</span>
<div class="zline" style="font-size: 13px; line-height: 1.7; display: flex; gap: 6px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#5EEAD4" stroke-width="3" aria-hidden="true" style="flex: none; margin-top: 6px"><path d="M5 12l5 5 9-10"></path></svg>کارکرد: ۲۸ هزار کیلومتر</div><div class="zline" style="font-size: 13px; line-height: 1.7; display: flex; gap: 6px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#5EEAD4" stroke-width="3" aria-hidden="true" style="flex: none; margin-top: 6px"><path d="M5 12l5 5 9-10"></path></svg>۴۲ آگهی مشابه تو ۳۰ روز اخیر</div><div class="zline" style="font-size: 13px; line-height: 1.7; display: flex; gap: 6px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#5EEAD4" stroke-width="3" aria-hidden="true" style="flex: none; margin-top: 6px"><path d="M5 12l5 5 9-10"></path></svg>میانه‌ی قیمت بازار: ۱٫۵۶ میلیارد</div>
</div>
<div style="background: #E6F4F1; border-radius: 14px; padding: 12px 14px; font-size: 13px; line-height: 1.8">نکته: سند و کارت ماشین رو با مشخصات آگهی چک کن.</div>
</div>

</main>
</div>
