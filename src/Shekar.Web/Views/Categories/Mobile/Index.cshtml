@model CategoriesViewModel
@{
    ViewData["Title"] = "انتخاب دسته";
    var planLabel = Model.Status.PlanType == PlanType.HunterPro ? "پلن حرفه‌ای"
        : Model.Status.PlanType == PlanType.Hunter ? "پلن شکارچی" : "مهمان";
}
@section css {
<link rel="stylesheet" href="~/css/mobile/base.css"><link rel="stylesheet" href="~/css/mobile/categories.css">
}
<div dir="rtl" style="width: 100%; max-width: 480px; margin: 0 auto; min-height: 100vh; font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; display: flex; flex-direction: column; position: relative">
<header style="padding: 12px 16px 0; display: flex; align-items: center; justify-content: space-between">
<a href="/" style="display: flex; align-items: center; gap: 8px; color: #111827"><svg width="30" height="30" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#FFFFFF" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b style="font-size: 18px">شکار</b></a>
<span style="font-size: 12px; color: #6B7280; background: #F6F8F8; padding: 5px 10px; border-radius: 999px">@planLabel</span>
</header>

<main style="padding: 10px 16px 10px; display: flex; flex-direction: column; gap: 10px; flex: 1; min-height: 0">
<div style="display: flex; flex-direction: column; gap: 4px">
<span style="display: flex; align-items: center; gap: 7px; color: #0F766E; font-size: 12px; font-weight: 700"><span class="zlive"></span>امروز @ViewFormat.Digits(Model.TodayTotal.ToString()) شکار تازه پیدا کردیم</span>
<h1 style="margin: 0; font-size: 24px; font-weight: 800">دنبال چه ماشینی هستی؟</h1>
<p style="margin: 0; color: #6B7280; font-size: 13px">یه بازه‌ی قیمت انتخاب کن تا شکارهاش رو ببینی.</p>
</div>

<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px">
@foreach (var cat in Model.Categories)
{
    <div class="zcat@(cat.BellOn ? " zcat-on" : "")">
    <form method="post" action="/bells/toggle" style="margin: 0">
    <input type="hidden" name="category" value="@cat.Category" />
    <input type="hidden" name="returnUrl" value="/categories" />
    <button class="zbell@(cat.BellOn ? " zbell-on" : "")" aria-label="خبرم کن: @cat.Label" aria-pressed="@(cat.BellOn ? "true" : "false")" type="submit">
    @if (cat.BellOn)
    {
        <svg width="17" height="17" viewBox="0 0 24 24" fill="#FFFFFF" stroke="#FFFFFF" stroke-width="1.8" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15z"></path></svg>
    }
    else
    {
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="1.8" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15z"></path><path d="M10 20.5a2 2 0 004 0"></path></svg>
    }
    </button>
    </form>
    <a href="/hunts?category=@cat.Category" class="zcat-a" aria-label="@cat.Label، @ViewFormat.Digits(cat.TodayCount.ToString()) شکار">
    <img src="~/assets/categories/@cat.ImageFileName" alt="" style="width: 58px; height: 58px; object-fit: contain; align-self: flex-start; margin: -2px -4px 0 0">
    <span style="display: flex; justify-content: space-between; align-items: baseline; gap: 6px"><b style="font-size: 14px; white-space: nowrap">@cat.Label</b><span style="font-size: 12px; font-weight: 700; color: #0F766E; white-space: nowrap">@ViewFormat.Digits(cat.TodayCount.ToString()) شکار</span></span>
    <span style="display: flex; align-items: center; gap: 4px; font-size: 11px; color: #6B7280; white-space: nowrap"><span class="zlive"></span>بروزرسانی: همین الان</span>
    </a>
    </div>
}
</div>
<div style="background: #FBF6E6; border: 1px solid #F1DFA6; border-radius: 14px; padding: 9px 12px; display: flex; gap: 10px; align-items: center">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8A6A0B" stroke-width="1.9" aria-hidden="true" style="flex: none"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15z"></path><path d="M10 20.5a2 2 0 004 0"></path></svg>
<span style="font-size: 12px; line-height: 1.7; color: #3F3305"><b>زنگوله رو بزن؛<br></b>تا ۲۴ ساعت شکارهای تازه‌ی اون دسته رو پیامک می‌کنیم.</span>
</div>
</main>

<nav aria-label="منوی پایین" style="background: #FFFFFF; border-top: 1px solid #EEF0F2; display: flex; padding: 4px 8px 14px">
<a href="/categories" class="znav znav-on" aria-current="page"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle></svg>شکارها</a>
<a href="/appraise" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path></svg>کارشناسی</a>
<a href="/plans" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"></rect><path d="M3 10h18"></path></svg>پلن‌ها</a>
<a href="/account" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg>حساب</a>
</nav>
</div>
