@{
    ViewData["Title"] = "ماشین زیر قیمت بازار رو شکار کن";
}
@section css {
<link rel="stylesheet" href="~/css/mobile/index.css">
}
<div dir="rtl" class="root">
<header class="hdr"><a href="/" style="display: flex; align-items: center; gap: 8px; color: var(--ink)"><svg width="32" height="32" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b style="font-size: 20px">شکار</b></a><a href="/login" class="btn btn-s" style="min-height: 40px; padding: 0 16px; font-size: 14px">ورود</a></header>
<main style="flex: 1">
<section class="hero" aria-labelledby="h1">
<span class="eyebrow" style="align-self: flex-start; padding: 5px 12px; font-size: 12px"><span class="live"></span>امروز ۱۲,۴۸۰ آگهی تهران بررسی شد</span>
<h1 id="h1" class="h1">ماشین زیر قیمت بازار رو<br><em>شکار کن!</em></h1>
<p class="lead">هوش مصنوعی شکار همه‌ی آگهی‌ها رو می‌سنجه و فقط اونایی که <b style="color: var(--ink)">زیر قیمت بازارن</b> و <b style="color: var(--ink)">زود فروش می‌رن</b> رو بهت می‌ده.</p>
<article class="hunt" aria-label="نمونه‌ی یه شکار امروز">
<div style="position: relative; height: 158px"><img src="~/assets/ads/peugeot-207.webp" alt="پژو ۲۰۷ پانوراما سفید" style="width: 100%; height: 100%; object-fit: cover; display: block">
<span class="chip chip-gold" style="position: absolute; top: 10px; right: 10px; font-size: 12px; padding: 3px 10px">فرصت طلایی</span>
<span style="position: absolute; top: 8px; left: 8px"><span class="ring" style="width: 44px; height: 44px" role="img" aria-label="امتیاز ۸۷ از ۱۰۰"><svg width="44" height="44" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="16" fill="none" stroke="#F1F3F4" stroke-width="4"></circle><circle cx="20" cy="20" r="16" fill="none" stroke="#D4A017" stroke-width="4" stroke-linecap="round" stroke-dasharray="87.4 100.5" transform="rotate(-90 20 20)"></circle></svg><b style="font-size: 14px">۸۷</b></span></span>
<span style="position: absolute; bottom: 8px; right: 10px; background: rgba(17,24,39,.72); color: #fff; font-size: 11px; padding: 3px 9px; border-radius: 999px">نمونه‌ی یه شکار امروز · ۳۵ دقیقه پیش</span></div>
<div style="padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 8px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px"><b style="font-size: 15px">پژو ۲۰۷ پانوراما ۱۴۰۲</b><span class="muted" style="font-size: 11px">۲۸ هزار km · تهرانپارس</span></div>
<div style="display: flex; align-items: baseline; gap: 8px"><b style="font-size: 20px">۱٫۳۴ میلیارد</b><s class="muted" style="font-size: 12px">بازار ۱٫۵۶ میلیارد</s></div>
<div class="tiles"><div style="background: var(--teal-50)"><b style="color: var(--teal)">۱۴٪</b><span style="color: var(--teal)">زیر بازار</span></div><div><b>۱۹۵ م</b><span>سود تخمینی</span></div><div><b>بالا</b><span>نقدشوندگی</span></div></div>
</div>
</article>
</section>

<section class="sec" aria-labelledby="how" style="padding-top: 8px">
<span class="kicker">شکار چطوری کار می‌کنه؟</span>
<h2 id="how" class="h2">از هزاران آگهی، فقط چندتا شکار</h2>
<div class="step"><span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7V5a1 1 0 011-1h2M17 4h2a1 1 0 011 1v2M20 17v2a1 1 0 01-1 1h-2M7 20H5a1 1 0 01-1-1v-2M7 12h10"></path></svg></span><div style="display: flex; flex-direction: column; gap: 4px"><b style="font-size: 15px">همه‌ی آگهی‌ها رو می‌خونیم</b><span class="muted" style="font-size: 13px; line-height: 1.8">هر آگهی خودروی تهران رو همون لحظه که منتشر می‌شه بررسی می‌کنیم.</span></div></div><div class="step"><span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path></svg></span><div style="display: flex; flex-direction: column; gap: 4px"><b style="font-size: 15px">قیمت و نقدشوندگی رو می‌سنجیم</b><span class="muted" style="font-size: 13px; line-height: 1.8">با هزاران آگهی مشابه مقایسه می‌کنیم: زیر قیمت بازاره؟ زود فروش می‌ره؟</span></div></div><div class="step"><span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle></svg></span><div style="display: flex; flex-direction: column; gap: 4px"><b style="font-size: 15px">فقط شکارها رو بهت می‌دیم</b><span class="muted" style="font-size: 13px; line-height: 1.8">بهترین‌ها با امتیاز و سود تخمینی تو لیستت میان؛ با پیامک هم خبرت می‌کنیم.</span></div></div>
<div class="stats" aria-label="آمار امروز"><div><b>۱۲,۴۸۰</b><span>آگهی امروز</span></div><div><b style="color: var(--mint)">۳۷</b><span>شکار امروز</span></div><div><b>۱۲٪</b><span>زیر بازار</span></div></div>
</section>

<section class="sec" aria-labelledby="ap" style="padding-top: 0">
<div style="background: linear-gradient(135deg, var(--teal), var(--teal-900)); color: #fff; border-radius: 22px; padding: 20px; display: flex; flex-direction: column; gap: 12px">
<span class="chip" style="align-self: flex-start; background: #fff; color: var(--teal); font-size: 12px; padding: 4px 10px">ماهی ۳ تا رایگان · فقط با ثبت‌نام</span>
<h2 id="ap" style="font-size: 19px; font-weight: 800; line-height: 1.6">لینک آگهی رو بده، تو ۲۰ ثانیه می‌گیم می‌ارزه یا نه</h2>
<label for="lkm" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0)">لینک آگهی</label>
<input id="lkm" type="url" dir="ltr" placeholder="https://…" style="min-height: 50px; border-radius: 14px; border: 0; padding: 0 14px; font: inherit; font-size: 16px">
<a href="/appraise" class="btn btn-w">رایگان بسنج</a>
</div>
</section>

<section class="sec" aria-labelledby="pl" style="padding-top: 0">
<span class="kicker">پلن‌ها · پرداخت ماهانه</span>
<h2 id="pl" class="h2">۲۴ ساعت اول، مهمون ما</h2>
<a href="/plans" class="plan plan-rec"><span class="chip" style="position: absolute; top: -11px; right: 16px; background: var(--teal); color: #fff; font-size: 11px; padding: 3px 10px">پیشنهاد ما</span><span style="display: flex; flex-direction: column; gap: 2px"><b style="font-size: 16px">شکارچی حرفه‌ای</b><span class="muted" style="font-size: 12px">همه‌چیز + پیامک شکارهای تازه</span></span><span style="text-align: left"><b style="font-size: 19px">۱,۴۹۹,۰۰۰</b><span class="muted" style="display: block; font-size: 11px">تومان / ماه</span></span></a>
<a href="/plans" class="plan"><span style="display: flex; flex-direction: column; gap: 2px"><b style="font-size: 16px">شکارچی</b><span class="muted" style="font-size: 12px">همه‌ی شکارها، همون لحظه</span></span><span style="text-align: left"><b style="font-size: 19px">۹۹۰,۰۰۰</b><span class="muted" style="display: block; font-size: 11px">تومان / ماه</span></span></a>
<div style="display: flex; justify-content: space-between; font-size: 13px"><b>ظرفیت تهران</b><b style="color: var(--danger)">۲۳ جا مونده</b></div>
<div class="cap" role="progressbar" aria-valuenow="77" aria-valuemin="0" aria-valuemax="100" aria-label="ظرفیت پرشده‌ی تهران"><i></i></div>
<div class="cities" aria-label="شهرها"><span class="city city-on"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>تهران · فعال</span><span class="city"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>کرج · به‌زودی</span><span class="city"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>اصفهان · به‌زودی</span><span class="city"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>مشهد · به‌زودی</span></div>
</section>

<section id="faq" class="sec" aria-labelledby="fq" style="padding-top: 0">
<h2 id="fq" class="h2">سؤال‌های پرتکرار</h2>
<div><details class="q" open><summary>امتیاز شکار یعنی چی؟<span class="plus" aria-hidden="true" style="width: 26px; height: 26px; border-radius: 50%; background: var(--soft); display: grid; place-items: center; font-size: 17px; flex: none">+</span></summary><p class="muted" style="margin-top: 8px; font-size: 14px; line-height: 1.85">یه عدد از ۰ تا ۱۰۰ که از قیمت نسبت به بازار، نقدشوندگی، کارکرد، وضعیت فنی و ریسک ماشین درمیاد. ۸۵ به بالا یعنی «فرصت طلایی».</p></details><details class="q"><summary>شکارها رو از کجا میارین؟<span class="plus" aria-hidden="true" style="width: 26px; height: 26px; border-radius: 50%; background: var(--soft); display: grid; place-items: center; font-size: 17px; flex: none">+</span></summary><p class="muted" style="margin-top: 8px; font-size: 14px; line-height: 1.85">از آگهی‌های عمومی خودروی تهران؛ همون لحظه که منتشر می‌شن بررسی‌شون می‌کنیم.</p></details><details class="q"><summary>چرا هر شهر فقط ۱۰۰ نفر؟<span class="plus" aria-hidden="true" style="width: 26px; height: 26px; border-radius: 50%; background: var(--soft); display: grid; place-items: center; font-size: 17px; flex: none">+</span></summary><p class="muted" style="margin-top: 8px; font-size: 14px; line-height: 1.85">که هر شکار بین آدمای کمتری تقسیم بشه و شانس تو برای خرید بیشتر باشه. ظرفیت پر بشه، لیست انتظار باز می‌شه.</p></details><details class="q"><summary>کارشناسی رایگان چطوریه؟<span class="plus" aria-hidden="true" style="width: 26px; height: 26px; border-radius: 50%; background: var(--soft); display: grid; place-items: center; font-size: 17px; flex: none">+</span></summary><p class="muted" style="margin-top: 8px; font-size: 14px; line-height: 1.85">فقط با ثبت‌نام و بدون اشتراک، ماهی ۳ آگهی رو رایگان کارشناسی می‌کنیم. با اشتراک، نامحدوده.</p></details></div>
</section>

<footer style="background: var(--soft); padding: 20px 16px; display: flex; flex-direction: column; gap: 10px; font-size: 13px; color: var(--muted)">
<span style="display: flex; align-items: center; gap: 8px; color: var(--ink)"><svg width="22" height="22" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b>شکار © ۱۴۰۵</b></span>
<nav aria-label="فوتر" style="display: flex; gap: 18px; flex-wrap: wrap"><a href="#" style="color: var(--muted)">قوانین</a><a href="#" style="color: var(--muted)">حریم خصوصی</a><a href="/contact" style="color: var(--muted)">تماس با ما</a></nav>
<span>قیمت و سود تخمینیه؛ قبل از خرید حتماً کارشناسی کن.</span>
</footer>
</main>
<div class="sticky"><a href="/categories" class="btn btn-p" style="width: 100%">دیدن شکارهای امروز</a><span class="muted" style="font-size: 12px; text-align: center">۲۴ ساعت اول رایگان · تهران فقط ۲۳ جا</span></div>
</div>
