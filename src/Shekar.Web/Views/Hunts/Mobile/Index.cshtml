@model HuntsViewModel
@{
    ViewData["Title"] = "شکارهای یک دسته";
    ViewData["Now"] = Model.Now;
    var cat = Model.List.Category;
    var label = cat is null ? "همه‌ی قیمت‌ها" : Model.Categories.First(c => c.Category == cat).Label;
    var bellOn = cat is not null && Model.Categories.First(c => c.Category == cat).BellOn;
    var catQ = cat is null ? "" : $"category={cat}&";
}
@section css {
<link rel="stylesheet" href="~/css/mobile/base.css"><link rel="stylesheet" href="~/css/mobile/hunts.css">
}
<div dir="rtl" style="width: 100%; max-width: 480px; margin: 0 auto; min-height: 100vh; font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; display: flex; flex-direction: column; position: relative">
<header style="position: sticky; top: 0; z-index: 5; background: #FFFFFF; padding: 12px 16px 0; display: flex; flex-direction: column; gap: 12px; border-bottom: 1px solid #E5E7EB">
<div style="display: flex; align-items: center; gap: 10px">
<a href="/categories" aria-label="برگشت به دسته‌ها" style="width: 44px; height: 44px; border-radius: 12px; background: #F6F8F8; display: grid; place-items: center; flex: none"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
<div style="flex: 1; min-width: 0"><span style="font-size: 12px; color: #6B7280">شکارهای</span><h1 style="margin: 0; font-size: 20px; font-weight: 800; line-height: 1.4">@label</h1></div>
<span style="display: inline-flex; align-items: center; gap: 6px; background: #E6F4F1; color: #0F766E; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; white-space: nowrap"><span class="zlive"></span>زنده</span>
</div>

@if (cat is not null)
{
    <div style="display: flex; align-items: center; gap: 10px; background: #F6F8F8; border-radius: 14px; padding: 8px 8px 8px 12px">
    <span style="flex: 1; font-size: 12px; color: #374151; line-height: 1.7">می‌خوای شکارهای تازه‌ی این دسته رو تا ۲۴ ساعت پیامک کنیم؟</span>
    <form method="post" action="/bells/toggle" style="margin: 0">
    <input type="hidden" name="category" value="@cat" />
    <input type="hidden" name="returnUrl" value="/hunts?category=@cat" />
    <button class="zbell@(bellOn ? " zbell-on" : "")" aria-pressed="@(bellOn ? "true" : "false")" type="submit">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="@(bellOn ? "#FFFFFF" : "none")" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15z"></path><path d="M10 20.5a2 2 0 004 0"></path></svg>
    @(bellOn ? "روشنه" : "خبرم کن")
    </button>
    </form>
    </div>
}

<div role="tablist" aria-label="بازه‌ی زمانی" style="display: flex">
@{
    var days = new[] { (HuntDay.Today, "امروز"), (HuntDay.Yesterday, "دیروز"), (HuntDay.TwoDaysAgo, "۲ روز پیش") };
}
@foreach (var (d, dlabel) in days)
{
    <a role="tab" class="ztab@(Model.List.Day == d ? " ztab-on" : "")" aria-selected="@(Model.List.Day == d ? "true" : "false")" href="/hunts?@(catQ)day=@d&sort=@Model.List.Sort">@dlabel</a>
}
</div>
</header>

<main style="padding: 12px 16px 24px; display: flex; flex-direction: column; gap: 12px; flex: 1">
<div class="zrow" role="group" aria-label="مرتب‌سازی" style="display: flex; gap: 6px; overflow-x: auto; align-items: center">
@{
    var sorts = new[] { (HuntSortOrder.TopScore, "بیشترین امتیاز"), (HuntSortOrder.MostBelowMarket, "بیشترین زیر بازار"), (HuntSortOrder.Newest, "جدیدترین") };
}
@foreach (var (s, slabel) in sorts)
{
    <a class="zsort@(Model.List.Sort == s ? " zsort-on" : "")" aria-pressed="@(Model.List.Sort == s ? "true" : "false")" href="/hunts?@(catQ)day=@Model.List.Day&sort=@s">@slabel</a>
}
</div>
<span style="font-size: 12px; color: #6B7280">@ViewFormat.Digits(Model.List.ActiveCount.ToString()) شکار فعال پیدا کردیم</span>

<div style="position: relative">
<div style="display: flex; flex-direction: column; gap: 12px">
@foreach (var card in Model.List.Cards)
{
    <partial name="_Card" model="card" />
}
</div>
</div>
</main>

<nav aria-label="منوی پایین" style="position: sticky; bottom: 0; background: #FFFFFF; border-top: 1px solid #EEF0F2; display: flex; padding: 4px 8px 14px; z-index: 5">
<a href="/categories" class="znav znav-on" aria-current="page"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle></svg>شکارها</a>
<a href="/appraise" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path></svg>کارشناسی</a>
<a href="/plans" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"></rect><path d="M3 10h18"></path></svg>پلن‌ها</a>
<a href="/account" class="znav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg>حساب</a>
</nav>
</div>
