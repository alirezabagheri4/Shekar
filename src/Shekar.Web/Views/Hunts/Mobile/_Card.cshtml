@model HuntCardDto
@{
    var now = (DateTimeOffset)ViewData["Now"]!;
    var ringColor = Model.IsGolden ? "#D4A017" : "#0F766E";
    var liqColor = Model.Liquidity == Liquidity.High ? "#0F766E" : "#9CA3AF";
    var liqText = Model.Liquidity == Liquidity.High ? "نقدشوندگی بالا" : "نقدشوندگی متوسط";
    var href = Model.IsRemoved ? "#" : $"/hunts/{Model.Id}";
    var meta = Model.MileageKm is null
        ? $"{Model.ModelYear} · صفر کیلومتر · {Model.Location}"
        : $"{Model.ModelYear} · {ViewFormat.Digits((Model.MileageKm.Value / 1000).ToString())} هزار کیلومتر · {Model.Location}";
}
<a href="@href" class="zcard@(Model.IsRemoved ? " zcard-off" : "")" aria-label="@Model.Title" aria-disabled="@(Model.IsRemoved ? "true" : "false")" tabindex="@(Model.IsRemoved ? "-1" : "0")">
<div style="width: 116px; border-radius: 12px; background: #EEF2F2; display: grid; place-items: center; position: relative; flex: none; overflow: hidden; min-height: 124px">
@if (!string.IsNullOrEmpty(Model.ImageFileName))
{
    <img src="~/assets/ads/@Model.ImageFileName" alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover">
}
else
{
    <svg viewBox="0 0 400 170" width="86%" aria-hidden="true"><path d="M18 128 L24 104 Q30 88 62 84 L122 78 L166 48 Q178 40 198 40 L262 40 Q284 40 300 54 L332 80 L366 86 Q386 90 388 106 L390 126 Q390 134 380 134 L28 134 Q18 134 18 128 Z" fill="#F3F4F6" stroke="#94A3A8" stroke-width="3"></path><circle cx="96" cy="134" r="26" fill="#111827"></circle><circle cx="316" cy="134" r="26" fill="#111827"></circle></svg>
}
@if (Model.IsNew && !Model.IsRemoved)
{
    <span style="position: absolute; top: 6px; right: 6px; background: #0F766E; color: #FFFFFF; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px">تازه</span>
}
@if (Model.IsGolden)
{
    <span style="position: absolute; bottom: 6px; right: 6px; left: 6px; text-align: center; background: #D4A017; color: #111827; font-size: 11px; font-weight: 700; padding: 2px 6px; border-radius: 999px">فرصت طلایی</span>
}
</div>
<div style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px">
<div style="display: flex; justify-content: space-between; gap: 6px; align-items: flex-start"><b style="font-size: 14px; line-height: 1.6">@Model.Title</b><span style="position: relative; display: inline-grid; place-items: center; flex: none; width: 34px; height: 34px"><svg width="34" height="34" viewBox="0 0 40 40" role="img" aria-label="امتیاز شکار @ViewFormat.Digits(Model.Score.ToString())" style="flex: none"><circle cx="20" cy="20" r="16" fill="none" stroke="#E6F4F1" stroke-width="5"></circle><circle cx="20" cy="20" r="16" fill="none" stroke="@ringColor" stroke-width="5" stroke-linecap="round" stroke-dasharray="@Model.Score 100.5" transform="rotate(-90 20 20)"></circle></svg><span aria-hidden="true" style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.15; font-family: Vazirmatn, Tahoma, sans-serif"><span style="font-size: 11px; font-weight: 800; color: #111827">@ViewFormat.Digits(Model.Score.ToString())</span></span></span></div>
<span style="font-size: 11px; color: #6B7280">@meta</span>
<div style="display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap"><b style="font-size: 15px">@ViewFormat.PriceToman(Model.PriceToman)</b><s style="font-size: 11px; color: #6B7280">بازار @ViewFormat.Price(Model.MarketMedianToman)</s></div>
<div style="display: flex; gap: 4px; flex-wrap: wrap"><span class="zv" style="background: #E6F4F1; color: #0F766E; font-size: 11px">@ViewFormat.Digits(Model.BelowMarketPercent.ToString())٪ زیر بازار</span><span class="zv" style="background: #F3F4F6; color: #111827; font-size: 11px">سود @ViewFormat.Profit(Model.EstimatedProfitToman)</span></div>
@if (Model.IsRemoved)
{
    <span style="align-self: flex-start; background: #E5E7EB; color: #374151; font-size: 11px; font-weight: 700; padding: 4px 8px; border-radius: 8px">آگهی حذف شده</span>
}
else
{
    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #6B7280"><span style="display: inline-flex; align-items: center; gap: 4px"><span style="width: 7px; height: 7px; border-radius: 50%; background: @liqColor"></span>@liqText</span><span>@ViewFormat.RelativeTime(Model.PublishedAt, now)</span></div>
}
</div>
</a>
