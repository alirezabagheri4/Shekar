@{
    ViewData["Title"] = "جزئیات آگهی";
}
@section css {
<link rel="stylesheet" href="~/css/mobile/base.css"><link rel="stylesheet" href="~/css/mobile/hunt-detail.css">
}
<div dir="rtl" style="width: 100%; max-width: 480px; margin: 0 auto; min-height: 100vh; font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; display: flex; flex-direction: column">
<div style="position: relative; height: 290px; background: #EEF2F2; display: grid; place-items: center">
<img src="~/assets/ads/peugeot-207.webp" alt="تصویر آگهی: نمای جلو" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover">
<a href="/hunts" aria-label="بازگشت به شکارها" style="position: absolute; top: 12px; right: 12px; width: 44px; height: 44px; border-radius: 12px; background: #FFFFFF; display: grid; place-items: center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
<span style="position: absolute; top: 20px; left: 14px; background: #D4A017; color: #111827; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px">فرصت طلایی</span>
<div style="position: absolute; bottom: 14px; left: 0; right: 0; display: flex; justify-content: center; gap: 6px; background: transparent">
<button class="zdot zdot-on" aria-label="نمای جلو" style="height: 8px"></button><button class="zdot" aria-label="نمای کناری" style="height: 8px"></button><button class="zdot" aria-label="نمای عقب" style="height: 8px"></button><button class="zdot" aria-label="داخل" style="height: 8px"></button><button class="zdot" aria-label="کیلومترشمار" style="height: 8px"></button><button class="zdot" aria-label="سند" style="height: 8px"></button>
</div>
<span style="position: absolute; bottom: 10px; left: 12px; background: rgba(17,24,39,.7); color: #FFFFFF; font-size: 12px; padding: 3px 8px; border-radius: 999px">۱ از ۶</span>
</div>

<div style="padding: 16px; display: flex; flex-direction: column; gap: 16px">

<div style="display: flex; flex-direction: column; gap: 8px">
<h1 style="margin: 0; font-size: 20px; font-weight: 800; line-height: 1.6">پژو ۲۰۷ دنده‌ای پانوراما ۱۴۰۲، کم‌کار و سند تک‌برگ</h1>
<div style="display: flex; align-items: center; justify-content: space-between"><b style="font-size: 22px">۱,۳۴۰,۰۰۰,۰۰۰ <span style="font-size: 13px; font-weight: 500; color: #6B7280">تومان</span></b><span style="background: #E6F4F1; color: #0F766E; font-weight: 700; font-size: 13px; padding: 3px 10px; border-radius: 8px">۱۴٪ زیر بازار</span></div>
<span style="color: #6B7280; font-size: 13px">۳۵ دقیقه پیش در تهران، تهرانپارس</span>
</div>

<section class="zbox" aria-labelledby="sc" style="display: flex; flex-direction: column; gap: 14px">
<div style="display: flex; justify-content: space-between; align-items: center"><h2 id="sc" style="margin: 0; font-size: 17px">امتیاز شکار</h2><span style="font-size: 12px; color: #6B7280">بر اساس ۴۲ آگهی مشابه</span></div>
<div style="display: flex; align-items: center; gap: 14px">
<span style="position: relative; display: inline-grid; place-items: center; flex: none; width: 104px; height: 104px"><svg width="104" height="104" viewBox="0 0 128 128" role="img" aria-label="امتیاز شکار ۸۷ از ۱۰۰"><circle cx="64" cy="64" r="54" fill="none" stroke="#F3F4F6" stroke-width="12"></circle><circle cx="64" cy="64" r="54" fill="none" stroke="#D4A017" stroke-width="12" stroke-linecap="round" class="zring" stroke-dasharray="295.2 339.3" transform="rotate(-90 64 64)"></circle></svg><span aria-hidden="true" style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1"><b style="font-size: 30px; font-weight: 800; color: #111827">۸۷</b><span style="font-size: 12px; color: #6B7280">از ۱۰۰</span></span></span>
<div style="display: flex; flex-direction: column; gap: 6px; min-width: 0">
<span style="align-self: flex-start; background: #D4A017; color: #111827; font-weight: 800; font-size: 13px; padding: 3px 12px; border-radius: 999px">فرصت طلایی</span>
<b style="font-size: 14px; line-height: 1.7">از ۹۲٪ آگهی‌های مشابه بهتره</b>
<span style="font-size: 13px; color: #6B7280; line-height: 1.7">قیمت پایین + فروش سریع؛ یعنی حاشیه‌ی سود خوب با ریسک کم.</span>
</div>
</div>
<div style="display: flex; flex-direction: column; gap: 12px">

<div style="display: flex; flex-direction: column; gap: 6px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 14px"><b>قیمت</b><span style="display: inline-flex; align-items: center; gap: 6px"><span style="font-size: 12px; font-weight: 700; color: #0F766E">عالی</span><b style="min-width: 26px; text-align: left">۹۳</b></span></div>
<div style="height: 8px; background: #F3F4F6; border-radius: 8px; overflow: hidden"><div class="zbarw" style="height: 100%; width: 93%; background: #0F766E; border-radius: 8px"></div></div>
<span style="font-size: 12px; color: #6B7280">۱۴٪ زیر میانه‌ی بازار</span>
</div>

<div style="display: flex; flex-direction: column; gap: 6px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 14px"><b>نقدشوندگی</b><span style="display: inline-flex; align-items: center; gap: 6px"><span style="font-size: 12px; font-weight: 700; color: #0F766E">عالی</span><b style="min-width: 26px; text-align: left">۹۲</b></span></div>
<div style="height: 8px; background: #F3F4F6; border-radius: 8px; overflow: hidden"><div class="zbarw" style="height: 100%; width: 92%; background: #0F766E; border-radius: 8px"></div></div>
<span style="font-size: 12px; color: #6B7280">۲۰۷های مشابه معمولاً ۲ تا ۴ روزه فروش می‌رن</span>
</div>

<div style="display: flex; flex-direction: column; gap: 6px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 14px"><b>کارکرد</b><span style="display: inline-flex; align-items: center; gap: 6px"><span style="font-size: 12px; font-weight: 700; color: #0F766E">خیلی خوب</span><b style="min-width: 26px; text-align: left">۸۶</b></span></div>
<div style="height: 8px; background: #F3F4F6; border-radius: 8px; overflow: hidden"><div class="zbarw" style="height: 100%; width: 86%; background: #0F766E; border-radius: 8px"></div></div>
<span style="font-size: 12px; color: #6B7280">۲۸ هزار کیلومتر؛ کمتر از میانگین این مدل</span>
</div>

<div style="display: flex; flex-direction: column; gap: 6px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 14px"><b>وضعیت فنی</b><span style="display: inline-flex; align-items: center; gap: 6px"><span style="font-size: 12px; font-weight: 700; color: #14B8A6">خیلی خوب</span><b style="min-width: 26px; text-align: left">۸۰</b></span></div>
<div style="height: 8px; background: #F3F4F6; border-radius: 8px; overflow: hidden"><div class="zbarw" style="height: 100%; width: 80%; background: #14B8A6; border-radius: 8px"></div></div>
<span style="font-size: 12px; color: #6B7280">طبق آگهی: یه لکه رنگ گلگیر جلو</span>
</div>

<div style="display: flex; flex-direction: column; gap: 6px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 14px"><b>کم‌ریسکی</b><span style="display: inline-flex; align-items: center; gap: 6px"><span style="font-size: 12px; font-weight: 700; color: #14B8A6">خوب</span><b style="min-width: 26px; text-align: left">۷۴</b></span></div>
<div style="height: 8px; background: #F3F4F6; border-radius: 8px; overflow: hidden"><div class="zbarw" style="height: 100%; width: 74%; background: #14B8A6; border-radius: 8px"></div></div>
<span style="font-size: 12px; color: #6B7280">۲ نکته قبل از خرید چک کن</span>
</div>

</div>
</section>

<section class="zbox" aria-labelledby="mk" style="display: flex; flex-direction: column; gap: 14px">
<div style="display: flex; justify-content: space-between; align-items: center"><h2 id="mk" style="margin: 0; font-size: 17px">حساب‌وکتاب سود</h2><span style="font-size: 12px; color: #0F766E; font-weight: 700">اطمینان: بالا</span></div>
<div style="padding-top: 32px; position: relative">
<div style="position: absolute; top: 0; left: 20%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center;"><span style="background: #111827; color: #FFFFFF; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 8px; white-space: nowrap">این آگهی</span><span style="width: 2px; height: 12px; background: #111827"></span></div>
<div style="display: flex; height: 10px; border-radius: 999px; overflow: hidden; gap: 4px"><span style="flex: 1; background: #FCA5A5"></span><span style="flex: 1.2; background: #5EEAD4"></span><span style="flex: 1; background: #D4A017"></span></div>
<div style="display: flex; justify-content: space-between; margin-top: 6px; font-size: 11px; color: #6B7280"><span>گرون</span><span>منصفانه · ۱٫۵۰ تا ۱٫۶۲ میلیارد</span><span style="color: #8A6A0B; font-weight: 700">فرصت طلایی</span></div>
</div>
<dl style="margin: 0; display: flex; flex-direction: column; font-size: 14px">
<div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #EEF0F2"><dt style="color: #6B7280">میانه‌ی قیمت بازار</dt><dd style="margin: 0; font-weight: 700">۱٬۵۶۰ میلیون</dd></div>
<div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #EEF0F2"><dt style="color: #6B7280">قیمت این آگهی</dt><dd style="margin: 0; font-weight: 700">− ۱٬۳۴۰ میلیون</dd></div>
<div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #EEF0F2"><dt style="color: #6B7280">هزینه‌ی نقل‌وانتقال و فروش</dt><dd style="margin: 0; font-weight: 700">− ۲۵ میلیون</dd></div>
</dl>
<div style="display: flex; justify-content: space-between; align-items: center; background: #0F766E; color: #FFFFFF; border-radius: 14px; padding: 12px 14px"><span style="display: flex; flex-direction: column"><span style="font-size: 12px; color: #CDEBE5">سود خالص تخمینی</span><b style="font-size: 20px">۱۹۵ میلیون تومان</b></span><span style="text-align: left; font-size: 12px; color: #CDEBE5; line-height: 1.6">فروش دوباره<br><b style="color: #FFFFFF; font-size: 13px">۳ تا ۵ روز</b></span></div>
</section>

<div style="display: flex; flex-wrap: wrap; gap: 8px">
<span style="background: #FEF3C7; color: #92400E; font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 999px">یه لکه رنگ ذکر شده</span>
<span style="background: #FEF3C7; color: #92400E; font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 999px">بیمه‌ی بدنه نداره</span>
<span style="background: #E6F4F1; color: #0F766E; font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 999px">سند تک‌برگ ذکر شده</span>
</div>

<div style="background: #E6F4F1; border-radius: 14px; padding: 14px; font-size: 14px; line-height: 1.8"><b style="color: #0F766E; display: block">خلاصه‌ی هوش مصنوعی</b>۲۰۷ پانوراما با کارکرد کم، حدود ۱۴٪ زیر قیمت بازار و پرفروش.<br>یه لکه رنگ گلگیر ذکر شده؛ قبل از خرید حتماً کارشناسی بدنه بگیر.</div>

<section aria-labelledby="sp">
<h2 id="sp" style="margin: 0 0 4px; font-size: 17px">مشخصات</h2>
<dl style="margin: 0">
<div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">کارکرد</dt><dd style="margin: 0; font-weight: 600">۲۸,۰۰۰ کیلومتر</dd></div><div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">مدل (سال تولید)</dt><dd style="margin: 0; font-weight: 600">۱۴۰۲</dd></div><div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">رنگ</dt><dd style="margin: 0; font-weight: 600">سفید</dd></div><div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">برند و مدل</dt><dd style="margin: 0; font-weight: 600">پژو ۲۰۷ پانوراما</dd></div><div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">مهلت بیمه‌ی شخص ثالث</dt><dd style="margin: 0; font-weight: 600">۷ ماه</dd></div><div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">نوع گیربکس</dt><dd style="margin: 0; font-weight: 600">دنده‌ای</dd></div><div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">نوع سوخت</dt><dd style="margin: 0; font-weight: 600">بنزینی</dd></div><div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">قیمت پایه</dt><dd style="margin: 0; font-weight: 600">۸۹۰ میلیون تومان</dd></div><div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">وضعیت موتور</dt><dd style="margin: 0; font-weight: 600">سالم</dd></div><div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">وضعیت شاسی‌ها</dt><dd style="margin: 0; font-weight: 600">سالم و پلمپ</dd></div><div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">وضعیت بدنه</dt><dd style="margin: 0; font-weight: 600">یه لکه رنگ (گلگیر جلو)</dd></div><div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #EEF0F2; font-size: 14px"><dt style="color: #6B7280">وضعیت گیربکس</dt><dd style="margin: 0; font-weight: 600">سالم</dd></div>
</dl>
</section>

<nav aria-label="خدمات">
<a href="/appraise" class="zrow"><span>بررسی و کارشناسی</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></a>
<a href="/appraise" class="zrow"><span>ارزیابی قیمت</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></a>
<a href="#" class="zrow"><span>خرید با تسهیلات</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></a>
</nav>

<section aria-labelledby="sd" style="display: flex; flex-direction: column; gap: 8px">
<div style="display: flex; justify-content: space-between; align-items: center"><h2 id="sd" style="margin: 0; font-size: 17px">توضیحات فروشنده</h2><span style="background: #F6F8F8; padding: 4px 10px; border-radius: 999px; font-size: 12px">فروشنده · شخصی (آقای مرادی)</span></div>
<p style="margin: 0; line-height: 1.9; color: #374151; font-size: 14px">ماشین تمیز و کم‌کار، سرویس‌ها به‌موقع. فقط یه لکه رنگ گلگیر جلو. سند تک‌برگ، بیمه تا اردیبهشت. به‌خاطر خرید ماشین جدید، فوری فروشیه.</p>
</section>

<section aria-labelledby="mp" style="display: flex; flex-direction: column; gap: 8px">
<h2 id="mp" style="margin: 0; font-size: 17px">موقعیت</h2>
<div style="height: 170px; border-radius: 14px; background: #F1F5F4; overflow: hidden"><svg width="100%" height="100%" viewBox="0 0 400 170" preserveAspectRatio="xMidYMid slice" role="img" aria-label="نقشه‌ی موقعیت تقریبی: تهران، تهرانپارس"><path d="M0 40 L400 60 M0 120 L400 100 M80 0 L100 170 M300 0 L290 170" stroke="#FFFFFF" stroke-width="12"></path><path d="M0 82 Q150 60 400 86" stroke="#FDE68A" stroke-width="8" fill="none"></path><circle cx="200" cy="80" r="38" fill="#0F766E" opacity=".14"></circle><path d="M200 46c-12 0-20 8-20 19 0 14 20 32 20 32s20-18 20-32c0-11-8-19-20-19z" fill="#0F766E"></path><circle cx="200" cy="65" r="6" fill="#FFFFFF"></circle></svg></div>
<span style="color: #6B7280; font-size: 13px">تهران، تهرانپارس — موقعیت تقریبی</span>
</section>
<p style="margin: 0; font-size: 12px; color: #6B7280; text-align: center">قیمت و سود تخمینیه و تضمینی نیست؛ قبل از خرید حتماً کارشناسی کن.</p>
</div>

<div style="position: sticky; bottom: 0; margin-top: auto; background: #FFFFFF; border-top: 1px solid #EEF0F2; padding: 12px 16px 20px">
<a href="#" class="zbtn zbtn-p">تماس از طریق آگهی اصلی<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"></path></svg></a>

</div>
</div>
