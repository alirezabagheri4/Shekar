@model HuntCardDto
@{
    var now = (DateTimeOffset)ViewData["Now"]!;
    var ringColor = Model.IsGolden ? "#D4A017" : "#0F766E";
    var liqColor = Model.Liquidity == Liquidity.High ? "#0F766E" : "#9CA3AF";
    var liqText = Model.Liquidity == Liquidity.High ? "نقدشوندگی بالا" : "نقدشوندگی متوسط";
    var href = Model.IsRemoved ? "#" : $"/hunts/{Model.Id}";
    var meta = Model.MileageKm is null
        ? $"{Model.ModelYear} · صفر کیلومتر · {Model.Location}"
        : $"{Model.ModelYear} · {ViewFormat.Digits((Model.MileageKm.Value / 1000).ToString())} هزار کیلومتر · {Model.Location}";
}
<a href="@href" class="zcard@(Model.IsRemoved ? " zcard-off" : "")" aria-label="@Model.Title" aria-disabled="@(Model.IsRemoved ? "true" : "false")" tabindex="@(Model.IsRemoved ? "-1" : "0")">
<div style="height: 168px; background: #EEF2F2; display: grid; place-items: center; position: relative; overflow: hidden">
@if (!string.IsNullOrEmpty(Model.ImageFileName))
{
    <img src="~/assets/ads/@Model.ImageFileName" alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover">
}
else
{
    <svg viewBox="0 0 400 170" width="76%" aria-hidden="true"><ellipse cx="205" cy="152" rx="180" ry="9" fill="#111827" opacity=".1"></ellipse><path d="M18 128 L24 104 Q30 88 62 84 L122 78 L166 48 Q178 40 198 40 L262 40 Q284 40 300 54 L332 80 L366 86 Q386 90 388 106 L390 126 Q390 134 380 134 L28 134 Q18 134 18 128 Z" fill="#F3F4F6" stroke="#94A3A8" stroke-width="2"></path><circle cx="96" cy="134" r="26" fill="#111827"></circle><circle cx="316" cy="134" r="26" fill="#111827"></circle></svg>
}
<div style="position: absolute; top: 10px; right: 10px; left: 10px; display: flex; justify-content: space-between; align-items: flex-start; gap: 6px">
<span style="display: flex; gap: 6px; flex-wrap: wrap">
@if (Model.IsNew && !Model.IsRemoved)
{
    <span style="background: #0F766E; color: #FFFFFF; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px">تازه</span>
}
@if (Model.IsGolden)
{
    <span style="background: #D4A017; color: #111827; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px">فرصت طلایی</span>
}
</span>
<span style="background: #FFFFFF; border-radius: 999px; padding: 3px; display: flex; box-shadow: 0 2px 8px rgba(17,24,39,.12)" aria-label="امتیاز شکار @ViewFormat.Digits(Model.Score.ToString()) از ۱۰۰"><span style="position: relative; display: inline-grid; place-items: center; flex: none; width: 32px; height: 32px"><svg width="32" height="32" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="16" fill="none" stroke="#E6F4F1" stroke-width="5"></circle><circle cx="20" cy="20" r="16" fill="none" stroke="@ringColor" stroke-width="5" stroke-linecap="round" stroke-dasharray="@Model.Score 100.5" transform="rotate(-90 20 20)"></circle></svg><span aria-hidden="true" style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.15; font-family: Vazirmatn, Tahoma, sans-serif"><span style="font-size: 11px; font-weight: 800; color: #111827">@ViewFormat.Digits(Model.Score.ToString())</span></span></span>
</div>
</div>
<div style="padding: 14px 16px 14px; display: flex; flex-direction: column; gap: 8px; flex: 1">
<b style="font-size: 15px; line-height: 1.6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">@Model.Title</b>
<span style="font-size: 12px; color: #6B7280">@meta</span>
<div style="display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap"><b style="font-size: 18px">@ViewFormat.PriceToman(Model.PriceToman)</b><s style="font-size: 12px; color: #6B7280">بازار @ViewFormat.Price(Model.MarketMedianToman)</s></div>
<div style="display: flex; gap: 6px; flex-wrap: wrap"><span class="zv" style="background: #E6F4F1; color: #0F766E">@ViewFormat.Digits(Model.BelowMarketPercent.ToString())٪ زیر بازار</span><span class="zv" style="background: #F3F4F6; color: #111827">سود @ViewFormat.Profit(Model.EstimatedProfitToman)</span></div>
@if (Model.IsRemoved)
{
    <span style="align-self: flex-start; background: #E5E7EB; color: #374151; font-size: 11px; font-weight: 700; padding: 4px 8px; border-radius: 8px">آگهی حذف شده</span>
}
else
{
    <div style="margin-top: auto; padding-top: 8px; border-top: 1px solid #EEF0F2; display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #6B7280"><span style="display: inline-flex; align-items: center; gap: 6px"><span style="width: 8px; height: 8px; border-radius: 50%; background: @liqColor"></span>@liqText</span><span>@ViewFormat.RelativeTime(Model.PublishedAt, now)</span></div>
}
</div>
</a>
