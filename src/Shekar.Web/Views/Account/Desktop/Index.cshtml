@{
    ViewData["Title"] = "حساب کاربری";
}
@section css {
<link rel="stylesheet" href="~/css/desktop/base.css"><link rel="stylesheet" href="~/css/desktop/account.css">
}
<div dir="rtl" style="font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #F6F8F8; min-height: 100vh">
<header style="position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.94); border-bottom: 1px solid #EEF0F2">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 32px; min-height: 72px; display: flex; align-items: center; gap: 36px">
<a href="/" style="display: flex; align-items: center; gap: 10px; color: #111827"><svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b style="font-size: 22px">شکار</b></a>
<nav aria-label="منوی اصلی" style="display: flex; gap: 28px; flex: 1"><a href="/hunts" style="color: #374151; font-weight: 500">شکارها</a><a href="/appraise" style="color: #374151; font-weight: 500">کارشناسی قیمت</a><a href="/plans" style="color: #374151; font-weight: 500">پلن‌ها</a><a href="/contact" style="color: #374151; font-weight: 500">تماس با ما</a></nav>
<span aria-hidden="true" style="width: 44px; height: 44px; border-radius: 50%; background: #0F766E; color: #FFFFFF; display: grid; place-items: center; font-weight: 700">ک</span>
</div>
</header>

<div style="max-width: 1280px; margin: 0 auto; padding: 32px 24px 80px; display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start">
<nav aria-label="حساب" style="flex: 1 1 240px; max-width: 280px; background: #FFFFFF; border-radius: 20px; padding: 12px; display: flex; flex-direction: column; gap: 4px">
<a href="#pf" class="zside zside-on">پروفایل</a>
<a href="#pl" class="zside">پلن و اشتراک</a>
<a href="#al" class="zside">هشدارهای «خبرم کن»</a>
<a href="#hs" class="zside">کارشناسی‌ها</a>
<a href="/contact" class="zside">تماس با ما</a>
<a href="/" class="zside" style="color: #DC2626">خروج از حساب</a>
</nav>

<main style="flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<h1 style="margin: 0; font-size: 28px; font-weight: 800">حساب کاربری</h1>

<section id="pf" class="zbox" aria-labelledby="h1">
<div style="display: flex; justify-content: space-between; align-items: center"><h2 id="h1" style="margin: 0; font-size: 18px">پروفایل</h2><button class="zbtn zbtn-s" style="min-height: 40px">ویرایش</button></div>
<dl style="margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px">
<div><dt style="color: #6B7280; font-size: 13px">نام و نام خانوادگی</dt><dd style="margin: 4px 0 0; font-weight: 700">کامران رضایی</dd></div>
<div><dt style="color: #6B7280; font-size: 13px">شماره موبایل</dt><dd dir="ltr" style="margin: 4px 0 0; font-weight: 700; text-align: right">۰۹۱۲ ۳۴۵ ۶۷۸۹</dd></div>
<div><dt style="color: #6B7280; font-size: 13px">شهر</dt><dd style="margin: 4px 0 0; font-weight: 700">تهران</dd></div>
</dl>
</section>

<section id="pl" class="zbox" aria-labelledby="h2" style="border: 2px solid #0F766E">
<h2 id="h2" style="margin: 0; font-size: 18px">پلن فعلی</h2>

<div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap">
<div style="display: flex; flex-direction: column; gap: 6px"><b style="font-size: 22px">شکارچی حرفه‌ای · ماهانه</b><span style="color: #6B7280">اعتبار تا ۳۰ آبان ۱۴۰۵ · <b style="color: #DC2626">۳۰ روز مانده</b></span></div>
<div style="display: flex; gap: 10px; flex-wrap: wrap"><a href="/pay/success" class="zbtn zbtn-p">تمدید</a></div>
</div>
<div style="height: 8px; background: #E6F4F1; border-radius: 8px; overflow: hidden"><div style="width: 4%; height: 100%; background: #0F766E"></div></div>

</section>

<section id="al" class="zbox" aria-labelledby="h3">
<div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap"><h2 id="h3" style="margin: 0; font-size: 18px">هشدارهای «خبرم کن»</h2><span style="font-size: 13px; color: #6B7280">پیامک به ۰۹۱۲۳۴۵۶۷۸۹</span></div>
<p style="margin: 0; font-size: 14px; color: #374151; background: #E6F4F1; border-radius: 12px; padding: 12px 14px">هر زنگوله‌ای که روشن کنی، تا ۲۴ ساعت شکارهای تازه‌ی اون دسته رو پیامک می‌کنیم؛ بعدش خودش خاموش می‌شه.</p>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px">

<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid #E5E7EB; border-radius: 12px"><span style="display: flex; flex-direction: column; gap: 2px"><span id="al0">زیر ۱ میلیارد</span><span style="font-size: 12px; color: #6B7280">خاموش</span></span><button role="switch" aria-checked="false" aria-labelledby="al0" class="zsw"></button></div>

<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid #E5E7EB; border-radius: 12px"><span style="display: flex; flex-direction: column; gap: 2px"><span id="al1">۱ تا ۱٫۵ میلیارد</span><span style="font-size: 12px; color: #0F766E">فعال · ۲۱ ساعت مونده</span></span><button role="switch" aria-checked="true" aria-labelledby="al1" class="zsw zsw-on"></button></div>

<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid #E5E7EB; border-radius: 12px"><span style="display: flex; flex-direction: column; gap: 2px"><span id="al2">۱٫۵ تا ۲ میلیارد</span><span style="font-size: 12px; color: #0F766E">فعال · ۸ ساعت مونده</span></span><button role="switch" aria-checked="true" aria-labelledby="al2" class="zsw zsw-on"></button></div>

<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid #E5E7EB; border-radius: 12px"><span style="display: flex; flex-direction: column; gap: 2px"><span id="al3">۲ تا ۳ میلیارد</span><span style="font-size: 12px; color: #6B7280">خاموش</span></span><button role="switch" aria-checked="false" aria-labelledby="al3" class="zsw"></button></div>

<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid #E5E7EB; border-radius: 12px"><span style="display: flex; flex-direction: column; gap: 2px"><span id="al4">۳ تا ۴ میلیارد</span><span style="font-size: 12px; color: #6B7280">خاموش</span></span><button role="switch" aria-checked="false" aria-labelledby="al4" class="zsw"></button></div>

<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid #E5E7EB; border-radius: 12px"><span style="display: flex; flex-direction: column; gap: 2px"><span id="al5">۴ تا ۸ میلیارد</span><span style="font-size: 12px; color: #6B7280">خاموش</span></span><button role="switch" aria-checked="false" aria-labelledby="al5" class="zsw"></button></div>

<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid #E5E7EB; border-radius: 12px"><span style="display: flex; flex-direction: column; gap: 2px"><span id="al6">۸ تا ۱۶ میلیارد</span><span style="font-size: 12px; color: #6B7280">خاموش</span></span><button role="switch" aria-checked="false" aria-labelledby="al6" class="zsw"></button></div>

<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid #E5E7EB; border-radius: 12px"><span style="display: flex; flex-direction: column; gap: 2px"><span id="al7">بالای ۱۶ میلیارد</span><span style="font-size: 12px; color: #6B7280">خاموش</span></span><button role="switch" aria-checked="false" aria-labelledby="al7" class="zsw"></button></div>

</div>

</section>

<section id="hs" class="zbox" aria-labelledby="h4">
<div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap"><h2 id="h4" style="margin: 0; font-size: 18px">کارشناسی‌ها</h2><span style="background: #E6F4F1; color: #0F766E; font-weight: 700; font-size: 13px; padding: 6px 12px; border-radius: 999px">کارشناسی نامحدود</span></div>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column">

<li style="display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid #EEF0F2; flex-wrap: wrap">
<div style="display: flex; flex-direction: column; gap: 2px"><b>پژو ۲۰۷ پانوراما ۱۴۰۲</b><span style="font-size: 13px; color: #6B7280">۲۹ مهر ۱۴۰۵</span></div>
<div style="display: flex; gap: 10px; align-items: center"><b>امتیاز ۸۷</b><span style="font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 999px; background: #D4A017; color: #111827">فرصت طلایی</span></div>
</li>

<li style="display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid #EEF0F2; flex-wrap: wrap">
<div style="display: flex; flex-direction: column; gap: 2px"><b>تارا اتوماتیک ۱۴۰۳</b><span style="font-size: 13px; color: #6B7280">۲۶ مهر ۱۴۰۵</span></div>
<div style="display: flex; gap: 10px; align-items: center"><b>امتیاز ۶۴</b><span style="font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 999px; background: #E6F4F1; color: #0F766E">منصفانه</span></div>
</li>

<li style="display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid #EEF0F2; flex-wrap: wrap">
<div style="display: flex; flex-direction: column; gap: 2px"><b>دنا پلاس ۱۴۰۱</b><span style="font-size: 13px; color: #6B7280">۲۰ مهر ۱۴۰۵</span></div>
<div style="display: flex; gap: 10px; align-items: center"><b>امتیاز ۳۸</b><span style="font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 999px; background: #FEE2E2; color: #B91C1C">گران</span></div>
</li>

</ul>
</section>
</main>
</div>
</div>
