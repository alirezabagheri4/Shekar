@model PlansViewModel
@{
    ViewData["Title"] = "پلن‌ها";
    var hunter = Model.Plans.First(p => p.Type == PlanType.Hunter);
    var pro = Model.Plans.First(p => p.Type == PlanType.HunterPro);
    var cap = Model.Capacity;
    string btn = "width: 100%; border: 0; cursor: pointer; font-family: inherit; display: flex; align-items: center; justify-content: center; min-height: 48px";
}
@section css {
<link rel="stylesheet" href="~/css/mobile/base.css"><link rel="stylesheet" href="~/css/mobile/plans.css">
}
<div dir="rtl" style="width: 100%; max-width: 480px; margin: 0 auto; min-height: 100vh; font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #F6F8F8; display: flex; flex-direction: column">
<header style="padding: 12px 16px; display: flex; align-items: center; gap: 12px; background: #FFFFFF; position: sticky; top: 0; z-index: 5">
<a href="/" aria-label="بازگشت" style="width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: #F6F8F8"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
<b style="font-size: 18px">پلن‌ها</b>
</header>

<main style="padding: 16px; display: flex; flex-direction: column; gap: 14px; flex: 1">
<div style="display: flex; flex-direction: column; gap: 4px">
<h1 style="margin: 0; font-size: 22px; font-weight: 800">پلنت رو انتخاب کن</h1>
<p style="margin: 0; color: #6B7280; font-size: 13px">پرداخت ماهانه · تهران فقط <b style="color: #DC2626">@ViewFormat.Digits(cap.Remaining.ToString()) جا مونده</b></p>
</div>

@if (TempData["PlansMsg"] is string msg)
{
    <div style="background: #FBF6E6; color: #8A6A0B; border: 1px solid #F1DFA6; border-radius: 12px; padding: 10px 12px; font-size: 13px; text-align: center">@msg</div>
}

<div class="zpl zpl-on" style="position: relative">
<span style="position: absolute; top: -12px; right: 18px; background: #0F766E; color: #FFFFFF; font-size: 12px; font-weight: 700; padding: 3px 12px; border-radius: 999px">پیشنهاد ما</span>
<span style="display: flex; align-items: baseline; justify-content: space-between; gap: 8px; width: 100%"><b style="font-size: 18px">@pro.Name</b><span style="display: flex; align-items: baseline; gap: 4px"><b style="font-size: 24px">@ViewFormat.Number(pro.MonthlyPriceToman)</b><span style="color: #6B7280; font-size: 12px">ت/ماه</span></span></span>
<span style="height: 1px; background: #EEF0F2; width: 100%"></span>
<span style="display: flex; flex-direction: column; gap: 8px; font-size: 13px; width: 100%">
@foreach (var feat in pro.Features)
{
    <span style="display: flex; align-items: center; gap: 8px"><span style="width: 18px; height: 18px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center; flex: none"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="3.2" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span><span>@feat</span></span>
}
</span>
<form method="post" action="/plans/subscribe" style="margin: 0; width: 100%"><input type="hidden" name="plan" value="HunterPro"><button type="submit" class="zbtn zbtn-p" style="@btn">خرید اشتراک حرفه‌ای</button></form>
</div>

<div class="zpl">
<span style="display: flex; align-items: baseline; justify-content: space-between; gap: 8px; width: 100%"><b style="font-size: 18px">@hunter.Name</b><span style="display: flex; align-items: baseline; gap: 4px"><b style="font-size: 24px">@ViewFormat.Number(hunter.MonthlyPriceToman)</b><span style="color: #6B7280; font-size: 12px">ت/ماه</span></span></span>
<span style="height: 1px; background: #EEF0F2; width: 100%"></span>
<span style="display: flex; flex-direction: column; gap: 8px; font-size: 13px; width: 100%">
@foreach (var feat in hunter.Features)
{
    <span style="display: flex; align-items: center; gap: 8px"><span style="width: 18px; height: 18px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center; flex: none"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="3.2" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span><span>@feat</span></span>
}
<span style="display: flex; align-items: center; gap: 8px; color: #9CA3AF"><span style="width: 18px; height: 18px; border-radius: 50%; background: #F3F4F6; display: grid; place-items: center; flex: none"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="3.2" aria-hidden="true"><path d="M6 12h12"></path></svg></span><span>پیامک شکارهای تازه</span></span>
</span>
<form method="post" action="/plans/trial" style="margin: 0; width: 100%"><button type="submit" class="zbtn zbtn-s" style="@btn">۲۴ ساعت رایگان امتحان کن</button></form>
<form method="post" action="/plans/subscribe" style="margin: 0; width: 100%; margin-top: 8px"><input type="hidden" name="plan" value="Hunter"><button type="submit" class="zbtn zbtn-p" style="@btn">خرید اشتراک شکارچی</button></form>
</div>

<p style="margin: 4px 0 0; color: #6B7280; font-size: 12px; text-align: center">پرداخت امن بانکی · هر ماه خودت تمدید کن</p>
</main>
</div>
