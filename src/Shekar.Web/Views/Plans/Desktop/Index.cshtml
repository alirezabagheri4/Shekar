@model PlansViewModel
@{
    ViewData["Title"] = "پلن‌ها";
    var hunter = Model.Plans.First(p => p.Type == PlanType.Hunter);
    var pro = Model.Plans.First(p => p.Type == PlanType.HunterPro);
    var cap = Model.Capacity;
    int usedPct = cap.Capacity == 0 ? 0 : (int)Math.Round(cap.Used * 100.0 / cap.Capacity);
    string btn = "width: 100%; border: 0; cursor: pointer; font-family: inherit; display: flex; align-items: center; justify-content: center";
}
@section css {
<link rel="stylesheet" href="~/css/desktop/base.css"><link rel="stylesheet" href="~/css/desktop/plans.css">
}
<div dir="rtl" style="font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #FFFFFF; min-height: 100vh">
<header style="position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.94); border-bottom: 1px solid #EEF0F2">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 32px; min-height: 72px; display: flex; align-items: center; gap: 36px">
<a href="/" style="display: flex; align-items: center; gap: 10px; color: #111827"><svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0F766E"></rect><circle cx="18" cy="18" r="8.5" fill="none" stroke="#fff" stroke-width="3"></circle><circle cx="18" cy="18" r="3" fill="#D4A017"></circle></svg><b style="font-size: 22px">شکار</b></a>
<nav aria-label="منوی اصلی" style="display: flex; gap: 28px; flex: 1"><a href="/hunts" style="color: #374151; font-weight: 500">شکارها</a><a href="/appraise" style="color: #374151; font-weight: 500">کارشناسی قیمت</a><a href="/plans" aria-current="page" style="color: #0F766E; font-weight: 700">پلن‌ها</a><a href="/contact" style="color: #374151; font-weight: 500">تماس با ما</a></nav>
<a href="/account" aria-label="حساب کاربری" style="width: 44px; height: 44px; border-radius: 50%; background: #E6F4F1; display: grid; place-items: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg></a>
</div>
</header>

<main style="max-width: 920px; margin: 0 auto; padding: 40px 24px 56px; display: flex; flex-direction: column; align-items: center; gap: 20px">
<div style="text-align: center; display: flex; flex-direction: column; gap: 6px"><h1 style="margin: 0; font-size: 32px; font-weight: 800">پلنت رو انتخاب کن</h1><p style="margin: 0; color: #6B7280; font-size: 16px">پرداخت ماهانه · هر شهر فقط ۱۰۰ اشتراک</p></div>

<div style="width: 100%; max-width: 560px; display: flex; flex-direction: column; gap: 8px">
<div style="display: flex; justify-content: space-between; font-size: 14px"><b>ظرفیت تهران</b><span style="color: #DC2626; font-weight: 700">فقط @ViewFormat.Digits(cap.Remaining.ToString()) جا مونده</span></div>
<div role="progressbar" aria-valuenow="@usedPct" aria-valuemin="0" aria-valuemax="100" style="height: 10px; border-radius: 999px; background: #E6F4F1; overflow: hidden"><div style="width: @(usedPct)%; height: 100%; background: #0F766E; border-radius: 999px"></div></div>
</div>

@if (TempData["PlansMsg"] is string msg)
{
    <div style="width: 100%; max-width: 720px; background: #FEF3C7; color: #92400E; border-radius: 12px; padding: 12px 16px; font-size: 14px; text-align: center">@msg</div>
}

<div style="width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: stretch">

<div class="zplan" style="border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 14px; background: #FFFFFF">
<b style="font-size: 22px">@hunter.Name</b>
<div style="display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap"><span style="font-size: 34px; font-weight: 800">@ViewFormat.Number(hunter.MonthlyPriceToman)</span><span style="color: #6B7280">تومان / ماه</span></div>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; flex: 1">
@foreach (var feat in hunter.Features)
{
    <li style="display: flex; align-items: center; gap: 10px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg><span>@feat</span></li>
}
<li style="display: flex; align-items: center; gap: 10px; color: #9CA3AF"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 12h12"></path></svg><span>پیامک شکارهای تازه</span></li>
</ul>
<form method="post" action="/plans/trial" style="margin: 0"><button type="submit" class="zbtn zbtn-s" style="@btn">۲۴ ساعت رایگان امتحان کن</button></form>
<form method="post" action="/plans/subscribe" style="margin: 0"><input type="hidden" name="plan" value="Hunter"><button type="submit" class="zbtn zbtn-p" style="@btn">خرید اشتراک شکارچی</button></form>
</div>

<div class="zplan zplan-rec" style="border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 14px; background: #FFFFFF; position: relative">
<span style="position: absolute; top: -14px; right: 28px; background: #0F766E; color: #FFFFFF; font-size: 13px; font-weight: 700; padding: 4px 14px; border-radius: 999px">پیشنهادی</span>
<b style="font-size: 22px">@pro.Name</b>
<div style="display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap"><span style="font-size: 34px; font-weight: 800">@ViewFormat.Number(pro.MonthlyPriceToman)</span><span style="color: #6B7280">تومان / ماه</span></div>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; flex: 1">
@foreach (var feat in pro.Features)
{
    <li style="display: flex; align-items: center; gap: 10px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg><span>@feat</span></li>
}
</ul>
<form method="post" action="/plans/subscribe" style="margin: 0; margin-top: auto"><input type="hidden" name="plan" value="HunterPro"><button type="submit" class="zbtn zbtn-p" style="@btn">خرید اشتراک حرفه‌ای</button></form>
</div>

</div>
<p style="margin: 0; color: #6B7280; font-size: 14px">فقط پرداخت ماهانه · پرداخت امن با درگاه بانکی · هر ماه خودت تمدید کن</p>
</main>
</div>
