@{
    ViewData["Title"] = "پرداخت";
}
@section css {
<link rel="stylesheet" href="~/css/desktop/base.css"><link rel="stylesheet" href="~/css/desktop/pay.css">
}
<div dir="rtl" style="font-family: Vazirmatn, Tahoma, sans-serif; color: #111827; background: #F6F8F8; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 40px 24px">
<div style="width: 100%; max-width: 480px; background: #FFFFFF; border-radius: 24px; padding: 40px 36px; box-shadow: 0 16px 48px rgba(17,24,39,.06); display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center">

<div style="width: 100%; display: flex; flex-direction: column; align-items: center; gap: 24px">
<svg class="zspin" width="56" height="56" viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="24" fill="none" stroke="#E6F4F1" stroke-width="6"></circle><path d="M28 4a24 24 0 0124 24" fill="none" stroke="#0F766E" stroke-width="6" stroke-linecap="round"></path></svg>
<div><h1 style="margin: 0 0 6px; font-size: 24px; font-weight: 800">داریم می‌ریم درگاه پرداخت…</h1><p style="margin: 0; color: #6B7280">چند ثانیه صبر کن و صفحه رو نبند.</p></div>
<div style="width: 100%; height: 6px; background: #E6F4F1; border-radius: 8px; overflow: hidden"><div class="zbar" style="height: 100%; background: #0F766E"></div></div>
<dl style="width: 100%; margin: 0; background: #F6F8F8; border-radius: 16px; padding: 18px 20px; display: flex; flex-direction: column; gap: 12px; font-size: 15px">
<div style="display: flex; justify-content: space-between"><dt style="color: #6B7280">پلن</dt><dd style="margin: 0; font-weight: 700">شکارچی حرفه‌ای · ماهانه</dd></div>
<div style="display: flex; justify-content: space-between"><dt style="color: #6B7280">مبلغ</dt><dd style="margin: 0; font-weight: 800">۱,۴۹۹,۰۰۰ تومان</dd></div>
</dl>
</div>

</div>
</div>
